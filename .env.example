# ===========================================
# HeroStack Environment Configuration
# ===========================================
# Copy this file to .env and configure values
# For Dokploy: Set these in Environment Variables UI
# ===========================================

# Database Configuration
# Supported types: "postgresql" (default), "sqlite"
DATABASE_TYPE="postgresql"

# PostgreSQL Configuration (default)
# For local: use 'localhost' as host
# For Docker Compose: use 'postgres' as host
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="herostack"
DB_PASSWORD="herostack123"
DB_NAME="herostack"

# Optional: Connection pool settings
# DB_MAX_CONNECTIONS="10"
# DB_IDLE_TIMEOUT="20"
# DB_CONNECT_TIMEOUT="10"

# SQLite Configuration (alternative - simpler setup)
# Uncomment these and set DATABASE_TYPE="sqlite" to use SQLite
# DATABASE_PATH="./data/herostack.db"

# ===========================================
# Auth.js Configuration (REQUIRED)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Your app URL (change for production)
AUTH_URL="http://localhost:3056"

# Session timeout in hours (default: 24)
# User will be automatically logged out after this duration
SESSION_TIMEOUT_HOURS="24"

# ===========================================
# OAuth Providers (Optional)
# ===========================================
# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
